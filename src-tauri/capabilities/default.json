{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口默认权限：核心 + 事件 + 文件对话框 + 文件系统 + shell（打开系统浏览器）",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "dialog:default",
    "fs:default",
    "shell:default"
  ]
}
